import($, Entity, Level) from "./levels/LevelSchema.jason"

level_name = "alex"
entities = [
    Entity("player", "Player", [30, 350], [40, 40]),

    Entity("ground", "Environment", [0, 400], [800, 20]),

    Entity("wall_left", "Environment", [0, 0], [15, 400]),
    Entity("wall_right", "Environment", [785, 0], [15, 400]),

    Entity("ceiling", "Environment", [0, 0], [800, 15]),

    Entity("platform1", "Environment", [50, 320], [120, 15]),
    Entity("platform2", "Environment", [220, 260], [100, 15]),
    Entity("platform3", "Environment", [370, 200], [100, 15]),
    Entity("platform4", "Environment", [520, 260], [100, 15]),
    Entity("platform5", "Environment", [670, 320], [120, 15]),
    Entity("platform6", "Environment", [150, 150], [80, 15]),
    Entity("platform7", "Environment", [400, 100], [80, 15]),
    Entity("platform8", "Environment", [600, 150], [80, 15]),
    Entity("playform8", "Enemy", [500, 100], [80, 15]),

    Entity("barrier1", "Environment", [300, 320], [15, 80]),
    Entity("barrier2", "Environment", [500, 320], [15, 80]),
    Entity("barrier3", "Environment", [200, 150], [15, 60]),
    Entity("barrier4", "Environment", [550, 150], [15, 60]),
]

level: Level = Level(level_name, entities)
out level
